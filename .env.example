EXPO_PUBLIC_API_URL=https://fixnow-production-f0e8.up.railway.app

# Keep database credentials on the backend host. For local development, use
# MYSQL_SSL=false only when connecting to a local MySQL server.
MYSQL_HOST=your-tidb-host
MYSQL_PORT=4000
MYSQL_USER=your-tidb-user
MYSQL_PASSWORD=your-tidb-password
MYSQL_DATABASE=fix_now
MYSQL_SSL=true
# Optional PEM certificate, if your database provider requires a custom CA:
# MYSQL_SSL_CA=-----BEGIN CERTIFICATE-----...
